{
  "manifest_version": 3,
  "name": "Navigation Switcher",
  "version": "1.0",
  "description": "Opens Google Maps links in Apple Maps.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://maps.app.goo.gl/*",
    "*://goo.gl/maps/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://maps.apple.com/*",
        "*://maps.app.goo.gl/*",
        "*://goo.gl/maps/*",
        "*://maps.google.com/*",
        "*://www.google.com/maps*",
        "*://google.com/maps*",
        "*://www.google.co.jp/maps*",
        "*://www.google.co.uk/maps*",
        "*://www.google.com.tr/maps*",
        "*://www.google.de/maps*",
        "*://www.google.fr/maps*",
        "*://www.google.es/maps*",
        "*://www.google.it/maps*"
      ],
      "js": [
        "convert.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Navigation Switcher"
  }
}
